# This repo is public. Everything personal lives in ~/.job-scan/ and must
# never appear here. These rules are a second line of defence — the first is
# that the data simply is not in this directory.

# Credentials
.env
.env.*
!.env.example
*.pem
*.key

# Real config (the example is the only one tracked)
config.toml
config.yaml
!config.example.toml

# Anything that could carry personal data if the workspace is ever copied in.
# Anchored to the root: unanchored, these would also hide functions/src/data/.
/data/
/reports/
/profile/
/cache/
*.eml
*.mbox

# Resume artifacts — the resume lives in its own repo
*.pdf
*.tex
!tests/fixtures/*.tex
*.docx
# Root only: unanchored, resume* would hide source files like resume.ts.
# Resume documents deeper in the tree are still caught by extension.
/resume*
resume*.md
resume*.txt

# Noise
__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# Workspace living in-tree: the interpreter wrapper (venv/ is above)
/bin/

# Azure Functions app. local.settings.json holds secrets for `func start`.
node_modules/
functions/dist/
local.settings.json
