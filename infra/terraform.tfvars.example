# Copy to terraform.tfvars (gitignored). Names only: each setting is resolved
# from the Key Vault secret named after it (GMAIL_MAIN_PASSWORD reads
# gmail-main-password). List the keys your config.toml reads; see
# infra/README.md#secrets.
mail_credential_envs = [
  "GMAIL_MAIN_USER",
  "GMAIL_MAIN_PASSWORD",
  "GMAIL_ALT_USER",
  "GMAIL_ALT_PASSWORD",
]

# Your Object ID (portal: Microsoft Entra ID → Users → you). The Key Vault,
# OpenAI and config roles stay with you, whoever runs the apply.
operator_principal_id = "00000000-0000-0000-0000-000000000000"
