{
  "name": "job-scan-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Functions app for the job-scan daily pipeline",
  "license": "MIT",
  "type": "module",
  "main": "dist/functions/*.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "azurite": "azurite --silent --location .azurite --skipApiVersionCheck",
    "prestart": "npm run build",
    "start": "func start"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.16.5",
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.34.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "entities": "8.1.0",
    "imapflow": "2.2.5",
    "postal-mime": "4.0.4",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "azurite": "3.37.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
