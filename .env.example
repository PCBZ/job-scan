# Generated by: fetch_mail.py --env-template
# One USER/PASSWORD pair per [[account]] in your ~/.job-scan/config.toml.
# Regenerate for your own account names:
#   ~/.job-scan/bin/python scripts/fetch_mail.py --env-template > .env
# Values below are placeholders — fill them in yourself.
#
# USER is the full email address, not a username.
# This file is read-only credentials for IMAP. The scan never sends,
# replies to, or deletes mail.

# Gmail: needs an App Password, not the account password, and each account needs its own.
#   Enable 2-Step Verification, then https://myaccount.google.com/apppasswords
#   Paste the 16 characters as shown; spaces are stripped.
# account 'gmail-main' (imap.gmail.com)
GMAIL_MAIN_USER=you@example.com
GMAIL_MAIN_PASSWORD=xxxxxxxxxxxxxxxx

# account 'gmail-alt' (imap.gmail.com)
GMAIL_ALT_USER=you@example.com
GMAIL_ALT_PASSWORD=xxxxxxxxxxxxxxxx

# Microsoft 365: most school and work tenants have basic auth disabled, in which
#   case no password here will connect. Run --check to find out before hunting for one.
# account 'school' (outlook.office365.com)
SCHOOL_USER=you@example.com
SCHOOL_PASSWORD=xxxxxxxxxxxxxxxx

# Outlook.com: needs an app password with two-step verification enabled.
#   Microsoft is also tightening basic auth here, so verify with --check.
# account 'outlook-personal' (outlook.office365.com)
OUTLOOK_PERSONAL_USER=you@example.com
OUTLOOK_PERSONAL_PASSWORD=xxxxxxxxxxxxxxxx

