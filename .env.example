# Copy to .env and fill in yourself. Claude will not write credentials here.
#   cp .env.example .env && chmod 600 .env
#
# One pair of keys per [[account]] in config.toml. The names must match that
# account's user_env / password_env, which default to <NAME>_USER and
# <NAME>_PASSWORD — the name uppercased with punctuation replaced by _.
#
# GMAIL — every account needs its OWN App Password. They are per-account, not
# per-device, so having one for your main inbox does nothing for the others:
#   1. Turn on 2-Step Verification for that account
#   2. https://myaccount.google.com/apppasswords -> generate one for "Mail"
#   3. Paste the 16 characters below (spaces are fine, they get stripped)
#
# MICROSOFT 365 / OUTLOOK — Microsoft disabled basic auth for Exchange Online
# and most school and work tenants left it off. If these fail with
# AUTHENTICATIONFAILED no matter what you paste, the tenant is the cause and no
# app password will fix it. Forward that mailbox to a Gmail account instead.
# Run `fetch_mail.py --check` to see which accounts actually connect.
#
# The scan only ever reads mail. It never sends, replies, or deletes.

GMAIL_MAIN_USER=you@gmail.com
GMAIL_MAIN_PASSWORD=xxxxxxxxxxxxxxxx

GMAIL_ALT_USER=other@gmail.com
GMAIL_ALT_PASSWORD=xxxxxxxxxxxxxxxx

SCHOOL_USER=you@university.edu
SCHOOL_PASSWORD=xxxxxxxxxxxxxxxx

OUTLOOK_PERSONAL_USER=you@outlook.com
OUTLOOK_PERSONAL_PASSWORD=xxxxxxxxxxxxxxxx
