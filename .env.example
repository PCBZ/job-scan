# Generated by: fetch_mail.py --env-template
# One USER/PASSWORD pair per [[account]] in your ~/.job-scan/config.toml.
# Regenerate for your own account names:
#   ~/.job-scan/bin/python scripts/fetch_mail.py --env-template > .env
# Values are left empty on purpose — fill each one in yourself.
#
# USER is the full email address, not a username.
# This file is read-only credentials for IMAP. The scan never sends,
# replies to, or deletes mail. The GitHub token at the end is added by hand;
# --env-template does not generate it.

# Gmail: needs an App Password, not the account password, and each account needs its own.
#   Enable 2-Step Verification, then https://myaccount.google.com/apppasswords
#   Paste the 16 characters as shown; spaces are stripped.
# account 'gmail-main' (imap.gmail.com)
# full email address
GMAIL_MAIN_USER=
# 16-character App Password, NOT the account password. Google disabled plain-password IMAP in 2022, so this is the only option, and it requires 2-Step Verification. Shown as four groups: abcd efgh ijkl mnop
GMAIL_MAIN_PASSWORD=

# account 'gmail-alt' (imap.gmail.com)
# full email address
GMAIL_ALT_USER=
# 16-character App Password, NOT the account password. Google disabled plain-password IMAP in 2022, so this is the only option, and it requires 2-Step Verification. Shown as four groups: abcd efgh ijkl mnop
GMAIL_ALT_PASSWORD=

# Outlook.com: needs an app password with two-step verification enabled.
#   Microsoft is also tightening basic auth here, so verify with --check.
# account 'outlook-personal' (outlook.office365.com)
# full email address
OUTLOOK_PERSONAL_USER=
# app password, created after enabling two-step verification on the Microsoft account
OUTLOOK_PERSONAL_PASSWORD=

# GitHub: read-only access to the resume repository, for the cloud resume
# reader in functions/ (GitHub REST contents API). Not used by the local skill.
#   Settings > Developer settings > Personal access tokens > Fine-grained tokens
#   Repository access: only the repo in [resume] repo. Permissions: Contents read-only.
GITHUB_RESUME_PAT=
