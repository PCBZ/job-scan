#!/bin/sh
# Block accidental commits of credentials or personal data.
# Install with ./install.sh, or: git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
note() { printf '  \033[31m%s\033[0m  %s\n' "$1" "$2"; fail=1; }

# --- path rules -----------------------------------------------------------
for f in $staged; do
  case "$f" in
    .env|.env.local|.env.*)
      [ "$f" = ".env.example" ] || note "$f" "credentials file" ;;
    config.toml|config.yaml)
      note "$f" "real config — commit config.example.toml instead" ;;
    local.settings.json|*/local.settings.json)
      note "$f" "Functions local settings hold secrets" ;;
    data/*|reports/*|profile/*|cache/*)
      note "$f" "workspace data (emails / reports / resume)" ;;
    *.eml|*.mbox|*.pdf)
      note "$f" "may contain personal data" ;;
    *.tex)
      case "$f" in tests/fixtures/*) ;; *) note "$f" "resume source belongs in its own repo" ;; esac ;;
  esac
done

# --- content rules --------------------------------------------------------
# A filled-in IMAP password, or a Google app password (16 lowercase letters,
# often written in four groups).
for f in $staged; do
  [ -f "$f" ] || continue
  case "$f" in .env.example) continue ;; esac

  if git show ":$f" 2>/dev/null | grep -qE '^[[:space:]]*IMAP_PASSWORD[[:space:]]*=[[:space:]]*[^x[:space:]#]'; then
    note "$f" "looks like a real IMAP_PASSWORD value"
  fi
  # A Google app password is 16 lowercase letters, often shown in four groups.
  # Only flag it in an assignment — matching the shape alone fires on any prose
  # that happens to string four short words together near the word "password",
  # and a hook that cries wolf just teaches people to pass --no-verify.
  if git show ":$f" 2>/dev/null \
       | grep -viE 'x{8,}' \
       | grep -qiE '(password|passwd|pwd|secret|token)[a-z_]*[[:space:]]*[=:][[:space:]]*.?[a-z]{4}[[:space:]]?[a-z]{4}[[:space:]]?[a-z]{4}[[:space:]]?[a-z]{4}'; then
    note "$f" "looks like a real credential assignment"
  fi
done

if [ "$fail" -ne 0 ]; then
  printf '\n\033[31mpre-commit blocked this commit.\033[0m\n'
  printf 'Personal data belongs in ~/.job-scan/, not in this repo.\n'
  printf 'If you are certain it is safe: git commit --no-verify\n\n'
  exit 1
fi
exit 0
